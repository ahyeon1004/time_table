# https://open.neis.go.kr/portal/guide/actKeyPage.do 에서 발급받은 인증키
# 이 파일을 .env.local로 복사하고 값을 입력하세요. 브라우저에는 전달하지 않습니다.
NEIS_API_KEY=

# Google Cloud > Google Auth Platform > 웹 애플리케이션 OAuth 클라이언트
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAINS=bssm.hs.kr
APP_ORIGIN=http://127.0.0.1:5173
# 승인된 리디렉션 URI: http://127.0.0.1:5173/api/auth/callback

# 웹 푸시 발신자 연락처. VAPID 키는 .data/web-push-keys.json에 자동 생성됩니다.
WEB_PUSH_SUBJECT=mailto:your-school-email@bssm.hs.kr
